  "version": "2.0.0",
  "tasks": [
    {
      "label": "Backend: levantar pila DEV (Docker)",
      "type": "shell",
      "command": "powershell -ExecutionPolicy Bypass -File dev-env/levantar-backend.ps1",
      "problemMatcher": []
    },
    {
      "label": "Backend: probar endpoints",
      "type": "shell",
      "command": "node dev-env/pruebas-endpoints.mjs",
      "problemMatcher": []
    },
    {
      "label": "Front: ng serve Colombia",
      "type": "npm",
      "script": "start:co",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "type": "npm",
      "script": "start",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": {
            "regexp": "Changes detected"
          },
          "endsPattern": {
            "regexp": "bundle generation (complete|failed)"
          }
        }
      }
    },
    {
      "type": "npm",
      "script": "test",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": {
            "regexp": "Changes detected"
          },
          "endsPattern": {
            "regexp": "bundle generation (complete|failed)"
          }
        }
      }
    }
  ]
}

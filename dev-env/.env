# Variables de la pila local del backend (DEV) para desarrollo del portal.
# Copia este archivo a dev-env/.env (no se versiona) — levantar-backend.ps1 lo hace solo la primera vez.
# Solo valores de DESARROLLO LOCAL: nada de esto es para un despliegue real.

DB_PASSWORD=changeme

# Puerto del Gateway en esta máquina: el 8080 lo ocupa otro proyecto (mera-cash-register-closure).
GATEWAY_PORT=8082

# Orígenes del portal autorizados por CORS en el Gateway (separados por comas). Cubre `ng serve` en los
# puertos del proyecto (4201 México, 4202 Colombia) y el 4200 por defecto de Angular. En producción, SOLO
# el dominio del portal (p. ej. https://tu-proyecto.vercel.app).
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4201,http://localhost:4202

# Captura de ventas (Sales Service) — vacías: la captura falla con un mensaje claro, el servicio arranca.
FACTURIZA_USERNAME=
FACTURIZA_PASSWORD=
SALES_CAPTURE_SCHEDULE_ENABLED=false
